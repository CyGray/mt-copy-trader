[Unit]
Description=ByTrader Node.js Worker (Telegram → MT5 Bridge)
After=network.target mt5-xvfb.service
Wants=mt5-xvfb.service

[Service]
Type=simple
User=kyle
Group=kyle
WorkingDirectory=/home/kyle/projects/ByTrader/worker

# Load environment from the .env.local file
EnvironmentFile=/home/kyle/projects/ByTrader/.env.local

# Start the compiled worker (build first with: npm run build --workspace worker)
ExecStart=/usr/bin/node dist/index.js

Restart=always
RestartSec=5
TimeoutStopSec=15

# Graceful shutdown via SIGTERM (handled in index.ts)
KillSignal=SIGTERM
SendSIGKILL=yes

# Resource limits
LimitNOFILE=65536

# Journal logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=bytrader-worker

[Install]
WantedBy=multi-user.target
