{
  "name": "bytrader",
  "private": true,
  "workspaces": [
    "web",
    "worker"
  ],
  "scripts": {
    "dev": "concurrently -n web,worker -c cyan,green \"npm run dev --workspace web\" \"npm run dev --workspace worker\"",
    "build": "npm run build --workspace web && npm run build --workspace worker",
    "build:web": "npm run build --workspace web",
    "lint": "npm run lint --workspace web && npm run lint --workspace worker",
    "lint:worker": "npm run lint --workspace worker",
    "lint:web": "npm run lint --workspace web",
    "test": "npm run test --workspace worker",
    "test:web": "npm run test --workspace web",
    "test:rules": "bash tests/firestore-rules/run.sh",
    "typecheck": "npx tsc -p worker/tsconfig.json --noEmit",
    "dev:autotrader": "npm run dev:autotrader --workspace worker"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "next": "14.2.5"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "lucide-react": "^0.563.0"
  }
}
