+    # [B2 patch] entry-side triggers for pending orders. A BUY_LIMIT fills when Ask' <= limit and a
+    # SELL_LIMIT when Bid' >= limit, i.e. on entry_px (not on exit_px / y as the B1 code did).
+    def _entry_hits(self, ge, level):
+        key = (2 if ge else 3, level)
+        h = self._hits.get(key)
+        if h is None:
+            h = np.flatnonzero(self.entry_px >= level) if ge else np.flatnonzero(self.entry_px <= level)
+            self._hits[key] = h
+        return h
+
+    def first_entry_ge(self, level, start, stop):
+        if start >= stop:
+            return None
+        h = self._entry_hits(True, level)
+        p = int(np.searchsorted(h, start))
+        if p < len(h) and h[p] < stop:
+            return int(h[p])
+        return None
+
+    def first_entry_le(self, level, start, stop):
+        if start >= stop:
+            return None
+        h = self._entry_hits(False, level)
+        p = int(np.searchsorted(h, start))
+        if p < len(h) and h[p] < stop:
+            return int(h[p])
+        return None
+
